# =========================================================================
# Safar Saarthi AI Service - Production Environment Variables
# =========================================================================

APP_NAME="Safar Saarthi AI Multi-Agent Service"
APP_ENV="production"
PORT=8000
HOST="0.0.0.0"
DEBUG=false

# LLM Provider Configuration ("gemini" or "openai")
LLM_PROVIDER="gemini"
GEMINI_API_KEY="YOUR_PRODUCTION_GOOGLE_GEMINI_API_KEY"
GEMINI_MODEL="gemini-1.5-flash"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Backend Core API URL
BACKEND_API_URL="http://backend:5000/api"

# Service-to-Service Security Token
AI_SERVICE_API_KEY="GENERATE_A_32_CHAR_RANDOM_SECRET_FOR_INTERNAL_API_CALLS"

# Performance Limits
MAX_REQUEST_BYTES=1048576
LLM_TIMEOUT_SECONDS=10.0

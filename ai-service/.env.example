# Safar Saarthi AI Service Configuration
APP_NAME="Safar Saarthi AI Multi-Agent Service"
APP_ENV="development"
PORT=8000
HOST="0.0.0.0"
DEBUG=true

# LLM Provider Configuration ("gemini", "openai", or "mock" for testing)
LLM_PROVIDER="mock"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Backend Core API URL
BACKEND_API_URL="http://localhost:5000/api"

# Service Security & Request Limits
AI_SERVICE_API_KEY=""
MAX_REQUEST_BYTES=1048576
LLM_TIMEOUT_SECONDS=12.0

// Safar Saarthi - Complete Database Schema (Phase 02)
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum Role {
  USER
  ADMIN
}

enum TravelMode {
  FLIGHT
  TRAIN
  BUS
  CAB_TRANSFER
}

enum TransportCategory {
  CHEAPEST
  FASTEST
  BEST_VALUE
}

enum OfferDataSource {
  LIVE
  CACHED
  DEMO
}

enum ProviderCategory {
  RAIL
  AIRLINE
  BUS_OPERATOR
  OTA_HOTEL
  ACTIVITIES
}

enum TripStatus {
  DRAFT
  PLANNED
  SAVED
  COMPLETED
}

enum AccommodationType {
  HERITAGE_HAVELI
  HOTEL
  RESORT
  BOUTIQUE_HOMESTAY
  HOSTEL
}

enum ActivityCategory {
  HERITAGE
  FOOD
  NATURE
  SHOPPING
  CULTURE
  RELAXATION
}

enum AgentRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum SyncStatus {
  SUCCESS
  PARTIAL
  FAILURE
}

// ----------------------------------------------------
// MODELS
// ----------------------------------------------------

model User {
  id              String          @id @default(uuid())
  email           String          @unique
  name            String
  passwordHash    String?
  preferences     Json?
  role            Role            @default(USER)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  trips           Trip[]
  savedTrips      SavedTrip[]
  searchHistories SearchHistory[]
  agentRuns       AgentRun[]

  @@map("users")
}

model Provider {
  id                   String                @id @default(uuid())
  code                 String                @unique // 'IRCTC', 'INDIGO', 'AIR_INDIA', 'REDBUS', etc.
  name                 String
  category             ProviderCategory
  officialUrl          String
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  transportOffers      TransportOffer[]
  accommodationOptions AccommodationOption[]
  syncLogs             ProviderSyncLog[]

  @@map("providers")
}

model Trip {
  id             String           @id @default(uuid())
  userId         String?
  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  title          String
  origin         String
  destination    String
  departureDate  DateTime
  returnDate     DateTime?
  travelers      Int              @default(1)
  totalBudget    Decimal?         @db.Decimal(10, 2)
  currency       String           @default("INR")
  status         TripStatus       @default(DRAFT)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  transportOffers TransportOffer[]
  itineraryDays   ItineraryDay[]
  savedTrips      SavedTrip[]
  agentRuns       AgentRun[]

  @@index([origin, destination])
  @@index([userId])
  @@index([departureDate])
  @@map("trips")
}

model TransportOffer {
  id              String            @id @default(uuid())
  tripId          String?
  trip            Trip?             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  providerId      String
  provider        Provider          @relation(fields: [providerId], references: [id], onDelete: Restrict)
  mode            TravelMode
  category        TransportCategory
  operator        String
  identifier      String            // e.g. "20977 Vande Bharat", "6E-205"
  originHub       String
  destinationHub  String
  departureTime   DateTime
  arrivalTime     DateTime
  durationMinutes Int
  baseFare        Decimal           @db.Decimal(10, 2)
  taxesAndFees    Decimal           @db.Decimal(10, 2)
  totalCost       Decimal           @db.Decimal(10, 2)
  currency        String            @default("INR")
  availableSeats  Int?
  seatClass       String?
  dataSource      OfferDataSource   @default(DEMO)
  bookingUrl      String
  firstMileCost   Decimal?          @db.Decimal(10, 2)
  lastMileCost    Decimal?          @db.Decimal(10, 2)
  transferNotes   String?
  lastSyncedAt    DateTime          @default(now())
  createdAt       DateTime          @default(now())

  @@index([tripId])
  @@index([providerId])
  @@index([mode])
  @@index([category])
  @@index([totalCost])
  @@map("transport_offers")
}

model AccommodationOption {
  id              String            @id @default(uuid())
  providerId      String?
  provider        Provider?         @relation(fields: [providerId], references: [id], onDelete: SetNull)
  destination     String
  name            String
  type            AccommodationType
  neighborhood    String
  proximityToHub  String
  pricePerNight   Decimal           @db.Decimal(10, 2)
  currency        String            @default("INR")
  rating          Decimal           @default(4.5) @db.Decimal(2, 1)
  reviewsCount    Int               @default(0)
  amenities       String[]
  bookingUrl      String
  isDemonstration Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([destination])
  @@index([pricePerNight])
  @@index([rating])
  @@map("accommodation_options")
}

model Place {
  id                     String            @id @default(uuid())
  destination            String
  title                  String
  location               String
  category               ActivityCategory
  description            String            @db.Text
  entryFee               Decimal           @default(0.00) @db.Decimal(10, 2)
  currency               String            @default("INR")
  typicalDurationMinutes Int               @default(90)
  insiderTip             String?           @db.Text
  bestTimeToVisit        String?
  latitude               Decimal?          @db.Decimal(9, 6)
  longitude              Decimal?          @db.Decimal(9, 6)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  activities             ItineraryActivity[]

  @@index([destination])
  @@index([category])
  @@map("places")
}

model ItineraryDay {
  id                  String              @id @default(uuid())
  tripId              String
  trip                Trip                @relation(fields: [tripId], references: [id], onDelete: Cascade)
  dayNumber           Int
  theme               String
  date                DateTime?
  dailyBudgetEstimate Decimal             @db.Decimal(10, 2)
  currency            String              @default("INR")
  localTransportTip   String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  activities          ItineraryActivity[]

  @@index([tripId, dayNumber])
  @@map("itinerary_days")
}

model ItineraryActivity {
  id              String           @id @default(uuid())
  itineraryDayId  String
  itineraryDay    ItineraryDay     @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)
  placeId         String?
  place           Place?           @relation(fields: [placeId], references: [id], onDelete: SetNull)
  timeSlot        String
  title           String
  location        String
  description     String           @db.Text
  entryFee        Decimal          @default(0.00) @db.Decimal(10, 2)
  durationMinutes Int              @default(60)
  category        ActivityCategory
  insiderTip      String?          @db.Text
  orderIndex      Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([itineraryDayId, orderIndex])
  @@map("itinerary_activities")
}

model SavedTrip {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  title     String
  notes     String?  @db.Text
  savedAt   DateTime @default(now())

  @@index([userId])
  @@index([tripId])
  @@map("saved_trips")
}

model SearchHistory {
  id             String       @id @default(uuid())
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  origin         String
  destination    String
  departureDate  DateTime
  returnDate     DateTime?
  travelers      Int          @default(1)
  budget         Decimal?     @db.Decimal(10, 2)
  preferredModes TravelMode[]
  searchedAt     DateTime     @default(now())

  @@index([origin, destination])
  @@index([userId])
  @@index([searchedAt])
  @@map("search_histories")
}

model AgentRun {
  id            String         @id @default(uuid())
  tripId        String?
  trip          Trip?          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  agentName     String         // 'COORDINATOR', 'TRANSPORT_AGENT', etc.
  status        AgentRunStatus @default(PENDING)
  inputPayload  Json
  outputPayload Json?
  errorMessage  String?        @db.Text
  durationMs    Int?
  startedAt     DateTime       @default(now())
  completedAt   DateTime?

  @@index([tripId])
  @@index([agentName])
  @@index([status])
  @@map("agent_runs")
}

model ProviderSyncLog {
  id            String     @id @default(uuid())
  providerId    String
  provider      Provider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  syncType      String     // 'FARE_SCRAPE_OFFICIAL', 'SCHEDULE_REFRESH', etc.
  status        SyncStatus
  recordsSynced Int        @default(0)
  durationMs    Int?
  message       String?    @db.Text
  syncedAt      DateTime   @default(now())

  @@index([providerId])
  @@index([status])
  @@index([syncedAt])
  @@map("provider_sync_logs")
}

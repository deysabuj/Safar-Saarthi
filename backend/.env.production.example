# =========================================================================
# Safar Saarthi Backend - Production Environment Variables
# =========================================================================

# Server Runtime Settings
PORT=5000
NODE_ENV=production
CORS_ORIGIN="https://safarsaarthi.in,https://www.safarsaarthi.in"

# Relational Database Connection (PostgreSQL with SSL & connection pooling)
DATABASE_URL="postgresql://safar_prod_user:StrongPasswordHere@db-cluster.internal:5432/safar_saarthi?schema=public&sslmode=prefer&connection_limit=25"

# Redis Distributed Cache & Rate Limiting
REDIS_HOST="redis-cluster.internal"
REDIS_PORT=6379
REDIS_PASSWORD="StrongRedisAuthPasswordHere"

# AI Specialist Service URL
AI_SERVICE_URL="http://ai-service:8000"

# Cryptographically Secure JWT Secret for User Authentication
# Generate with: openssl rand -base64 48
JWT_SECRET="GENERATE_A_64_CHARACTER_RANDOM_SECRET_KEY_FOR_PRODUCTION_JWT_SIGNING"

# Amadeus Flight Offers Search API (v2)
# Register at: https://developers.amadeus.com/
AMADEUS_CLIENT_ID="YOUR_PRODUCTION_AMADEUS_API_KEY"
AMADEUS_CLIENT_SECRET="YOUR_PRODUCTION_AMADEUS_API_SECRET"
AMADEUS_ENV="production"

# Indian Railways (CRIS / IRCTC Authorized Enterprise Gateway)
IRCTC_API_KEY="YOUR_OFFICIAL_IRCTC_API_KEY"
IRCTC_API_URL="https://irctc-indian-railway-pnr-status.p.rapidapi.com"
IRCTC_API_HOST="irctc-indian-railway-pnr-status.p.rapidapi.com"

# Intercity Bus (RedBus / State RTC Enterprise Gateway)
REDBUS_API_KEY="YOUR_COMMERCIAL_REDBUS_API_KEY"
REDBUS_API_URL="https://api.redbus.in/v1"

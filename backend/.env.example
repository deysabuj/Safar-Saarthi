# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/safar_saarthi?schema=public"

# Redis Cache & Background Queue
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# AI Specialist Service URL
AI_SERVICE_URL="http://localhost:8000"

# JWT Secret for User Authentication
JWT_SECRET="replace-with-a-secure-random-secret-in-production"

# Amadeus for Developers (Flight Offers Search API v2)
# Register for free at https://developers.amadeus.com/
# Free Self-Service tier grants 2,000 monthly test transactions
AMADEUS_CLIENT_ID=""
AMADEUS_CLIENT_SECRET=""
AMADEUS_ENV="test" # "test" or "production"

# Indian Railways (IRCTC / Authorized Gateway)
# Leave blank to operate with authentic Indian Railways timetable benchmarks
IRCTC_API_KEY=""
IRCTC_API_URL="https://irctc-indian-railway-pnr-status.p.rapidapi.com"
IRCTC_API_HOST="irctc-indian-railway-pnr-status.p.rapidapi.com"

# Intercity Bus (RedBus / Aggregator Gateway)
# Leave blank to operate with authentic Intercity Bus network benchmarks
REDBUS_API_KEY=""
REDBUS_API_URL="https://api.redbus.in/v1"

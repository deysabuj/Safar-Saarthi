# =========================================================================
# Safar Saarthi - Root Environment Configuration (Docker Compose)
# =========================================================================

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=safar_saarthi
POSTGRES_PORT=5432

# Redis Cache
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS Settings
CORS_ORIGIN=http://localhost:5173,http://localhost:80,http://localhost

# JWT Authentication Secret (MUST change to 64+ random hex chars in production!)
JWT_SECRET=dev-safar-saarthi-secret-key-change-in-prod-replace-with-secure-key

# AI Provider Configuration ("mock", "gemini", or "openai")
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_SERVICE_API_KEY=

# Transport Provider Credentials (Optional — defaults to authentic benchmarks if left blank)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test
IRCTC_API_KEY=
REDBUS_API_KEY=
